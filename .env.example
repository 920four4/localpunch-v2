# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URLs
NEXT_PUBLIC_SITE_URL=https://www.localpunchcard.io

# QR / redeem token signing (required in production)
QR_SIGNING_SECRET=generate-a-long-random-string

# Stripe billing (required for merchant go-live)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Loops email (optional — no-ops if missing)
LOOPS_API_KEY=
LOOPS_TX_MERCHANT_WELCOME=
LOOPS_TX_MERCHANT_DAY1=
LOOPS_TX_MERCHANT_DAY3=
LOOPS_TX_MERCHANT_DAY7=
LOOPS_TX_MERCHANT_DAY14=
LOOPS_TX_MERCHANT_PAYMENT_FAILED=
LOOPS_TX_MERCHANT_CANCELED=
LOOPS_TX_CUSTOMER_WELCOME=

# Blog admin API (optional — for programmatic publishing)
BLOG_API_TOKEN=

# Claude blog generation in /admin/blog (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_BLOG_MODEL=claude-opus-4-20250514

# Twilio SMS for redeem notifications (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Scripts only
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
