# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URLs
NEXT_PUBLIC_SITE_URL=https://www.localpunchcard.io

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1M5B0X50Z8
# Measurement Protocol secret (server revenue from Stripe) — GA4 Admin → Data streams → API secrets
GA4_API_SECRET=

# QR / redeem token signing (required in production)
QR_SIGNING_SECRET=generate-a-long-random-string

# Stripe billing (required for merchant go-live)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (transactional API + Supabase Auth SMTP — same API key)
RESEND_API_KEY=
RESEND_SMTP_PASSWORD=
RESEND_FROM_EMAIL=auth@localpunchcard.io
RESEND_REPLY_TO=auth@localpunchcard.io

# Daily crons (merchant drip + Telegram digest). Vercel sends this as a Bearer token.
CRON_SECRET=

# Telegram Insights — posts key events to the shared "920four apps" group.
# Bot token is shared across all 920four apps; topic id is unique to LocalPunch.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1003727025008
TELEGRAM_TOPIC_ID=4
NOTIFY_APP_NAME=LocalPunch
# Resend webhook signing secret (whsec_…) — only if the Resend email webhook is wired.
RESEND_WEBHOOK_SECRET=

# Contact form (defaults shown). Sends via Resend from the verified localpunchcard.io domain.
CONTACT_INBOX_EMAIL=localpunchcard@920four.com
CONTACT_REPLY_TO=localpunchcard@920four.com
RESEND_CONTACT_FROM=contact@localpunchcard.io

# Blog admin API (optional — for programmatic publishing)
BLOG_API_TOKEN=

# Claude blog generation in /admin/blog (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_BLOG_MODEL=claude-opus-4-20250514

# Twilio SMS for redeem notifications (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Scripts only
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
